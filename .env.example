# ReadEase Environment Configuration
# Copy this file to .env and customize for your local setup

# Flask Secret Key for session signing and CSRF protection
SECRET_KEY=dev-secret-key-change-in-production-readease-2026

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1

# SQLite Database URI (defaults to instance/readease.db inside the project)
DATABASE_URL=sqlite:///readease.db

# Upload Configuration (in bytes, 10MB = 10 * 1024 * 1024)
MAX_CONTENT_LENGTH=10485760

# Optional SMTP Email Configuration for Password Reset and Verification
# Leave blank to use safe local development mode (reset links printed to console & flash message)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
